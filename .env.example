################################################################################
# Office Suite v7.2 - Environment Variables
#
# Copy this file to .env and replace all CHANGE_ME values.
# Do not commit real secrets to git.
################################################################################

#-------------------------------------------------------------------------------
# Project / Compose
#-------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=office-suite-v7
TZ=Asia/Kolkata
ENVIRONMENT=production

#-------------------------------------------------------------------------------
# Domains / Public URLs
#-------------------------------------------------------------------------------
# Main domain served by Traefik / Cloudflare
DOMAIN=office.example.com

# API domain used by frontend
API_DOMAIN=api.office.example.com

# Public frontend URL hosted on Cloudflare Pages
FRONTEND_URL=https://office.example.com

# Matrix / Dendrite public URL
MATRIX_DOMAIN=matrix.office.example.com
MATRIX_HOMESERVER_URL=https://matrix.office.example.com

# CryptPad public URL
CRYPTPAD_URL=https://docs.office.example.com

# Authentik public URL
AUTHENTIK_URL=https://auth.office.example.com

# Grafana public URL
GRAFANA_URL=https://monitor.office.example.com

#-------------------------------------------------------------------------------
# TLS / Traefik / Cloudflare Edge
#-------------------------------------------------------------------------------
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESS_LOG=true

CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_KV_NAMESPACE_SESSIONS=CHANGE_ME
CLOUDFLARE_KV_NAMESPACE_RATE_LIMITS=CHANGE_ME

#-------------------------------------------------------------------------------
# PostgreSQL
#-------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=office_suite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=office_suite
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# Backup location inside container / host mount
POSTGRES_BACKUP_DIR=/backups/postgres

#-------------------------------------------------------------------------------
# Redis
#-------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=450mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

#-------------------------------------------------------------------------------
# MinIO - Hot object storage
#-------------------------------------------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Buckets
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_TEMP=temp-uploads
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_CHAT_MEDIA=chat-media
MINIO_BUCKET_BACKUPS=backups

#-------------------------------------------------------------------------------
# Cloudflare R2 - Warm / CDN tier
#-------------------------------------------------------------------------------
R2_ENABLED=true
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_BUCKET=office-suite-r2
R2_REGION=auto

#-------------------------------------------------------------------------------
# Backblaze B2 - Cold tier
#-------------------------------------------------------------------------------
B2_ENABLED=true
B2_APPLICATION_KEY_ID=CHANGE_ME
B2_APPLICATION_KEY=CHANGE_ME
B2_BUCKET=office-suite-b2
B2_ENDPOINT=CHANGE_ME.backblazeb2.com

#-------------------------------------------------------------------------------
# Storj - Archive tier
#-------------------------------------------------------------------------------
STORJ_ENABLED=true
STORJ_ACCESS_KEY=CHANGE_ME
STORJ_BUCKET=office-suite-storj
STORJ_ENDPOINT=CHANGE_ME.storjshare.io

#-------------------------------------------------------------------------------
# Mega Cloud Backup (25GB free tier)
#-------------------------------------------------------------------------------
MEGA_ENABLED=false
MEGA_EMAIL=CHANGE_ME
MEGA_PASSWORD=CHANGE_ME
MEGA_BACKUP_PATH=/OfficeSuite/backups

#-------------------------------------------------------------------------------
# IBM Cloud Object Storage - Cold/Archive tier
#-------------------------------------------------------------------------------
IBM_COS_ENABLED=false
IBM_COS_API_KEY=CHANGE_ME
IBM_COS_SERVICE_INSTANCE_ID=CHANGE_ME
IBM_COS_BUCKET=office-suite-archive
IBM_COS_ENDPOINT=CHANGE_ME
IBM_COS_REGION=us-south

#-------------------------------------------------------------------------------
# Google OAuth 2.0 & Drive
#-------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.office.example.com/api/v1/auth/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

#-------------------------------------------------------------------------------
# LiveKit - WebRTC for voice/video calls
#-------------------------------------------------------------------------------
LIVEKIT_ENABLED=false
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16
LIVEKIT_API_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

#-------------------------------------------------------------------------------
# Box - Optional overflow storage (10GB free tier)
#-------------------------------------------------------------------------------
BOX_ENABLED=false
BOX_CLIENT_ID=CHANGE_ME
BOX_CLIENT_SECRET=CHANGE_ME
BOX_FOLDER_ID=0

#-------------------------------------------------------------------------------
# pCloud - Optional overflow storage (10GB free tier)
#-------------------------------------------------------------------------------
PCLOUD_ENABLED=false
PCLOUD_USERNAME=CHANGE_ME
PCLOUD_PASSWORD=CHANGE_ME
PCLOUD_FOLDER_ID=0

#-------------------------------------------------------------------------------
# Cloudinary - Media optimization (25GB free tier)
#-------------------------------------------------------------------------------
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

#-------------------------------------------------------------------------------
# ImageKit - Image processing (20GB free tier)
#-------------------------------------------------------------------------------
IMAGEKIT_ENABLED=false
IMAGEKIT_PUBLIC_KEY=CHANGE_ME
IMAGEKIT_PRIVATE_KEY=CHANGE_ME
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/CHANGE_ME

#-------------------------------------------------------------------------------
# Tigris - Edge-cached CDN (5GB free, 10K writes + 100K reads/month)
#-------------------------------------------------------------------------------
TIGRIS_ENABLED=false
TIGRIS_ACCESS_KEY=CHANGE_ME
TIGRIS_SECRET_KEY=CHANGE_ME
TIGRIS_ENDPOINT=https://s3.tigris.cloud
TIGRIS_BUCKET=office-suite-cdn
TIGRIS_CDN_URL=https://office-suite-cdn.tigris.cloud

#-------------------------------------------------------------------------------
# Neon Object Storage - Branch-isolated scratch (5GB free during beta)
#-------------------------------------------------------------------------------
NEON_STORAGE_ENABLED=false
NEON_STORAGE_API_KEY=CHANGE_ME
NEON_STORAGE_ENDPOINT=https://storage.neon.tech

#-------------------------------------------------------------------------------
# Sia - Decentralized encrypted archive (50GB free)
#-------------------------------------------------------------------------------
SIA_ENABLED=false
SIA_API_ENDPOINT=http://localhost:9980
SIA_API_PASSWORD=CHANGE_ME

#-------------------------------------------------------------------------------
# Box Developer Edition - API-first overflow (10GB, 250MB file limit)
#-------------------------------------------------------------------------------
BOX_DEV_ENABLED=false
BOX_DEV_CLIENT_ID=CHANGE_ME
BOX_DEV_CLIENT_SECRET=CHANGE_ME

#-------------------------------------------------------------------------------
# Vercel Blob - Frontend thumbnail cache (1GB Hobby plan)
#-------------------------------------------------------------------------------
VERCEL_BLOB_ENABLED=false
VERCEL_BLOB_TOKEN=CHANGE_ME

#-------------------------------------------------------------------------------
# Karakeep - Self-hosted bookmark manager with AI
#-------------------------------------------------------------------------------
KARAKEEP_ENABLED=false
KARAKEEP_API_URL=http://karakeep:3000
KARAKEEP_API_KEY=CHANGE_ME

#-------------------------------------------------------------------------------
# PGVector - PostgreSQL vector search extension
#-------------------------------------------------------------------------------
PGVECTOR_ENABLED=true

#-------------------------------------------------------------------------------
# Ollama - Self-hosted embedding model
#-------------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text

#-------------------------------------------------------------------------------
# Swarm (Ethereum) - Immutable decentralized archive (50GB free)
#-------------------------------------------------------------------------------
SWARM_ENABLED=false
SWARM_API_URL=https://api.swarm-gateways.net
SWARM_BEE_NODE=
SWARM_POSTAGE_BATCH_ID=CHANGE_ME

#-------------------------------------------------------------------------------
# IDrive e2 - Long-term S3-compatible backup (10GB free)
#-------------------------------------------------------------------------------
IDRIVE_E2_ENABLED=false
IDRIVE_E2_ACCESS_KEY=CHANGE_ME
IDRIVE_E2_SECRET_KEY=CHANGE_ME
IDRIVE_E2_ENDPOINT=CHANGE_ME.idrivee2-4.com
IDRIVE_E2_BUCKET=office-suite-idrive

#-------------------------------------------------------------------------------
# Icedrive - Zero-knowledge encrypted sync (10GB free)
#-------------------------------------------------------------------------------
ICEDRIVE_ENABLED=false
ICEDRIVE_API_KEY=CHANGE_ME

#-------------------------------------------------------------------------------
# Sync.com - E2E encrypted sharing (5GB free)
#-------------------------------------------------------------------------------
SYNC_COM_ENABLED=false
SYNC_COM_API_KEY=CHANGE_ME

#-------------------------------------------------------------------------------
# Dropbox - Small file sharing (2GB free)
#-------------------------------------------------------------------------------
DROPBOX_ENABLED=false
DROPBOX_ACCESS_TOKEN=CHANGE_ME

#-------------------------------------------------------------------------------
# Fastio MCP - Active AI Database & RAG (50GB free)
#-------------------------------------------------------------------------------
FASTIO_MCP_ENABLED=false
FASTIO_MCP_URL=https://mcp.fast.io/mcp
FASTIO_MCP_API_KEY=CHANGE_ME

#-------------------------------------------------------------------------------
# Karakeep Configuration
#-------------------------------------------------------------------------------
KARAKEEP_NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
KARAKEEP_NEXTAUTH_URL=http://localhost:3000

#-------------------------------------------------------------------------------
# OxiCloud - Self-hosted file server UI (Rust, PostgreSQL, WebDAV)
#-------------------------------------------------------------------------------
OXICLOUD_ENABLED=false
OXICLOUD_ENDPOINT=http://oxicloud:8080

#-------------------------------------------------------------------------------
# MyDrive - Lightweight file server UI (S3-compatible)
#-------------------------------------------------------------------------------
MYDRIVE_ENABLED=false
MYDRIVE_ENDPOINT=http://mydrive:3000

#-------------------------------------------------------------------------------
# Cloudreve - Multi-cloud storage aggregator (mounts 15+ S3 services)
#-------------------------------------------------------------------------------
CLOUDREVE_ENABLED=false
CLOUDREVE_ENDPOINT=http://cloudreve:5212

#-------------------------------------------------------------------------------
# Async Task Processing (202 Accepted pattern)
#-------------------------------------------------------------------------------
ASYNC_TASK_ENABLED=true
ASYNC_TASK_LEASE_DURATION=300

#-------------------------------------------------------------------------------
# ClamAV - Antivirus scanning for uploaded files
#-------------------------------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_QUARANTINE_PATH=/backups/quarantine
CLAMAV_SCAN_TIMEOUT=300

#-------------------------------------------------------------------------------
# CrowdSec - Intrusion Prevention System (IPS)
#-------------------------------------------------------------------------------
CROWDSEC_ENABLED=true
CROWDSEC_TRAEFIK_BOUNCER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CROWDSEC_AUTO_BAN_THRESHOLD=5
CROWDSEC_AUTO_BAN_DURATION=24h

#-------------------------------------------------------------------------------
# Caching Configuration
#-------------------------------------------------------------------------------
CACHE_TTL_DEFAULT=300
CACHE_TTL_DOCUMENTS=600
CACHE_TTL_FEED=60
CACHE_TTL_SEATS=30

#-------------------------------------------------------------------------------
# Security Hardening
#-------------------------------------------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=300
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

#-------------------------------------------------------------------------------
# DPDP Act Compliance (India)
#-------------------------------------------------------------------------------
DPDP_COMPLIANCE_ENABLED=false
DPDP_DATA_RETENTION_DAYS=365
DPDP_CONSENT_REQUIRED=true

#-------------------------------------------------------------------------------
# Google OAuth / Google Drive
#-------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.office.example.com/api/v1/auth/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

#-------------------------------------------------------------------------------
# Auth / JWT / MPIN
#-------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_LONG_RANDOM
REFRESH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MPIN_PEPPER=CHANGE_ME_LONG_RANDOM
MPIN_LENGTH=6
MPIN_MAX_ATTEMPTS=5
MPIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

#-------------------------------------------------------------------------------
# SMTP / Email
#-------------------------------------------------------------------------------
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Office Suite v7.2
SMTP_STARTTLS=true

#-------------------------------------------------------------------------------
# Dendrite / Matrix
#-------------------------------------------------------------------------------
DENDRITE_SERVER_NAME=office.example.com
DENDRITE_DB_NAME=dendrite
DENDRITE_DB_USER=dendrite
DENDRITE_DB_PASSWORD=CHANGE_ME
DENDRITE_REGISTRATION_DISABLED=true
DENDRITE_FEDERATION_DISABLED=true
DENDRITE_MEDIA_MAX_FILE_SIZE_MB=25

# Matrix integration for app messenger
MATRIX_ACCESS_TOKEN=CHANGE_ME
MATRIX_ALERT_ROOM_ID=CHANGE_ME

#-------------------------------------------------------------------------------
# CryptPad
#-------------------------------------------------------------------------------
CRYPTPAD_ADMIN_EMAIL=admin@example.com
CRYPTPAD_HTTP_SAFE=false
CRYPTPAD_INSTALL_EXTENSIONS=true

#-------------------------------------------------------------------------------
# Authentik
#-------------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_POSTGRESQL_HOST=postgres
AUTHENTIK_POSTGRESQL_PORT=5432
AUTHENTIK_POSTGRESQL_NAME=authentik
AUTHENTIK_POSTGRESQL_USER=authentik
AUTHENTIK_POSTGRESQL_PASSWORD=CHANGE_ME
AUTHENTIK_REDIS_URL=redis://:CHANGE_ME@redis:6379/1
AUTHENTIK_DISABLE_UPDATE_CHECK=true

#-------------------------------------------------------------------------------
# Typesense
#-------------------------------------------------------------------------------
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=CHANGE_ME
TYPESENSE_DATA_DIR=/data

#-------------------------------------------------------------------------------
# Qdrant
#-------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME
QDRANT_COLLECTION_DOCUMENTS=documents
QDRANT_COLLECTION_POLICIES=policies

#-------------------------------------------------------------------------------
# SearXNG
#-------------------------------------------------------------------------------
SEARXNG_BASE_URL=https://search.office.example.com
SEARXNG_SECRET=CHANGE_ME

#-------------------------------------------------------------------------------
# Crawl4AI
#-------------------------------------------------------------------------------
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RESPONSE_BYTES=2097152
CRAWL_ALLOWED_DOMAINS=
CRAWL_BLOCKED_DOMAINS=localhost,127.0.0.1,10.0.0.0,192.168.0.0

#-------------------------------------------------------------------------------
# n8n
#-------------------------------------------------------------------------------
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n
N8N_DB_POSTGRESDB_USER=n8n
N8N_DB_POSTGRESDB_PASSWORD=CHANGE_ME

#-------------------------------------------------------------------------------
# AI Providers
#
# Multiple keys per provider are supported.
# Leave unused keys blank.
#-------------------------------------------------------------------------------
AI_DEFAULT_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2
AI_RETRY_LIMIT=3
AI_FALLBACK_ORDER=gemini,groq,deepseek,qwen,openrouter

# Gemini
GEMINI_ENABLED=true
GEMINI_API_KEY_1=CHANGE_ME
GEMINI_API_KEY_2=
GEMINI_MODEL_ID=gemini-2.0-flash

# Groq
GROQ_ENABLED=true
GROQ_API_KEY_1=CHANGE_ME
GROQ_MODEL_ID=llama-3.3-70b-versatile

# DeepSeek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY_1=CHANGE_ME
DEEPSEEK_MODEL_ID=deepseek-chat

# Qwen
QWEN_ENABLED=true
QWEN_API_KEY_1=CHANGE_ME
QWEN_MODEL_ID=qwen-max

# OpenRouter
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY_1=CHANGE_ME
OPENROUTER_MODEL_ID=anthropic/claude-3.5-sonnet

#-------------------------------------------------------------------------------
# OCR
#-------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=en,te,hi
OCR_MAX_PAGES_PER_TASK=20
OCR_TIMEOUT_SECONDS=600
OCR_WORKER_CONCURRENCY=1
OCR_MAX_TASKS_PER_CHILD=1

#-------------------------------------------------------------------------------
# Storage lifecycle
#-------------------------------------------------------------------------------
MINIO_HOT_RETENTION_HOURS=48
R2_LIFECYCLE_ENABLED=true
B2_LIFECYCLE_ENABLED=true
STORJ_ARCHIVE_AFTER_DAYS=30

#-------------------------------------------------------------------------------
# Backup / Restore
#-------------------------------------------------------------------------------
BACKUP_DIR=/opt/office-suite-v7/backups
BACKUP_ENCRYPTION_AGE_PUBLIC_KEY=CHANGE_ME
BACKUP_RETENTION_DAYS=14
RESTORE_DRILL_DIR=/opt/office-suite-v7/scratch/restore-drill
RCLONE_REMOTE_B2=b2
RCLONE_REMOTE_STORJ=storj
RCLONE_REMOTE_R2=r2

#-------------------------------------------------------------------------------
# Monitoring / Loki / Grafana
#-------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_URL_PATH=/
LOKI_RETENTION_DAYS=14

#-------------------------------------------------------------------------------
# Uptime / External alerting
#-------------------------------------------------------------------------------
UPTIMEROBOT_MONITOR_ID=CHANGE_ME
ALERT_EMAIL=ops@example.com

#-------------------------------------------------------------------------------
# Cloudreve (Admin-only multi-cloud storage aggregator)
#-------------------------------------------------------------------------------
# Admin credentials for Cloudreve UI (basic auth)
# Generate password hash: htpasswd -nbB admin YOUR_PASSWORD
CLOUDREVE_ADMIN_USER=admin
CLOUDREVE_ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_WITH_HTPASSWD

#-------------------------------------------------------------------------------
# Storage Provider Circuit Breakers
#-------------------------------------------------------------------------------
# Circuit breaker settings for each storage provider
# Open after N consecutive failures, half-open after M seconds
STORAGE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
STORAGE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

#-------------------------------------------------------------------------------
# AI Provider Key Rotation Counts
#-------------------------------------------------------------------------------
# Exact number of API keys per provider for rotation
GEMINI_KEY_COUNT=10
GROQ_KEY_COUNT=5

#-------------------------------------------------------------------------------
# Feature flags
#-------------------------------------------------------------------------------
FEATURE_FEED_TRIVIA=true
FEATURE_POLICY_CONFLICT_AGENT=true
FEATURE_SYSTEM_OVERSEER=true
FEATURE_GOOGLE_DRIVE_IMPORT=true
FEATURE_SEAT_PRESENCE=true
FEATURE_COMMAND_PALETTE=true
